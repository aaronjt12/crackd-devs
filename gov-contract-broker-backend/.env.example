# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/gov_contracts?schema=public"

# USAspending API Configuration
USASPENDING_API_BASE_URL=https://api.usaspending.gov/api/v2
USASPENDING_API_KEY=

# SAM.gov API Configuration (if needed)
SAM_API_KEY=
SAM_API_BASE_URL=https://api.sam.gov

# Email Configuration (for outreach)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# Sync Configuration
SYNC_INTERVAL_MINUTES=60
MAX_RECORDS_PER_SYNC=100

# Commission Configuration
DEFAULT_COMMISSION_PERCENTAGE=5

# Logging
LOG_LEVEL=info