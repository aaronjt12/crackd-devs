# TEST CONFIGURATION - Ready to use immediately!
# NO API KEY REQUIRED for USAspending.gov

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite for easy testing)
DATABASE_URL="file:./test.db"

# USAspending API Configuration
# This API is FREE and PUBLIC - no authentication needed!
USASPENDING_API_BASE_URL=https://api.usaspending.gov/api/v2
# No API key required - leave this blank
USASPENDING_API_KEY=

# Email Configuration (optional - will simulate if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=test@example.com

# Sync Configuration
SYNC_INTERVAL_MINUTES=60
MAX_RECORDS_PER_SYNC=10
DEFAULT_COMMISSION_PERCENTAGE=5

# Logging
LOG_LEVEL=info

# Mock Mode (set to false to use real API)
USE_MOCK_DATA=false